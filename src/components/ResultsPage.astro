---
import Base from '../layouts/Base.astro';
import Crumbs from './Crumbs.astro';
import ResultsList from './ResultsList.astro';
import type { ResultsPageData } from '../lib/results/page';
import { STAV_LABELS, RESULT_SPORTS } from '../lib/results/page';
import { group } from '../lib/results/status';
import { compName, compPath, resultPath, isStale } from '../lib/results/view';
import { pragueMidnight } from '../lib/results/time';
import { hhmm, longDay, addDays, dayKey, plural } from '../lib/text';
import { breadcrumbLd, SITE } from '../lib/seo';
import Icon from './Icon.astro';
import Bonus from './Bonus.astro';
interface Props { d: ResultsPageData }
const { d } = Astro.props;
const now = Date.now();
const noon = (k: string) => pragueMidnight(k) + 12 * 3600_000;
const isToday = d.key === d.today;
const yKey = dayKey(addDays(noon(d.today), -1));
const tKey = dayKey(addDays(noon(d.today), 1));
const dayName = isToday ? 'dnes' : d.key === yKey ? 'včera' : d.key === tKey ? 'zítra' : longDay(noon(d.key));
const h1 = `Výsledky ${d.sport.genitive} ${dayName}`;
const href = (o: { den?: string; soutez?: string; stav?: string }) => {
  const den = o.den ?? d.key;
  const q = new URLSearchParams({ ...(den !== d.today ? { den } : {}), ...((o.soutez ?? d.comp) ? { soutez: o.soutez ?? d.comp } : {}), ...((o.stav ?? d.stav) ? { stav: o.stav ?? d.stav } : {}) });
  return `${d.base}${q.size ? `?${q}` : ''}`;
};
const days: [string, string][] = [[yKey, 'Včera'], [d.today, 'Dnes'], [tKey, 'Zítra']].filter(([k]) => k >= d.minKey && k <= d.maxKey) as [string, string][];
const counts = (g: string) => d.all.filter((r) => (!d.comp || r.comp === d.comp) && (!g || group(r.status) === ({ probiha: 'live', skonceno: 'final', nadchazejici: 'upcoming' } as Record<string, string>)[g])).length;
const staleN = d.rows.filter((r) => isStale(r, now, d.staleMs)).length;
const live = d.all.some((r) => group(r.status) === 'live');
const canonical = d.noindex ? d.path : d.base;
const hub = !d.sport.id;
const crumbs = [{ name: 'Domů', href: '/' }, { name: 'Výsledky', href: '/vysledky/' }, ...(d.base !== '/vysledky/' ? [{ name: d.sport.name }] : [])];
// Title-sized list: two names, or the first two and "další soutěže".
const comps = hub ? 'fotbal, hokej, basketbal, volejbal a házená' : d.comps.length <= 2 ? d.comps.map(compName).join(' a ') : `${d.comps.slice(0, 2).map(compName).join(', ')} a další soutěže`;
const ld = [breadcrumbLd(crumbs), { '@context': 'https://schema.org', '@type': 'ItemList', name: h1, numberOfItems: d.rows.length, itemListElement: d.rows.slice(0, 30).map((r, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + resultPath(r), name: `${r.home} – ${r.away}` })) }];
---
<Base title={`${h1[0].toUpperCase()}${h1.slice(1)} – ${comps} | SportStreamy`} description={`${h1[0].toUpperCase()}${h1.slice(1)}: ${d.all.length} ${plural(d.all.length, 'zápas', 'zápasy', 'zápasů')} (${comps}). Skóre, stav zápasu a odkaz na detail s přenosem. Průběžně aktualizované výsledky.`} path={canonical} noindex={d.noindex} ld={ld} section="vysledky" ttl={isToday ? 60 : 600}>
  <div class="wrap">
    <Crumbs items={crumbs} />
    <section class="pagehead">
      <div class="kicker"><span>{longDay(noon(d.key))}</span>{live ? <span class="tag-live"><span class="dot"></span>Probíhá</span> : null}<span>· {d.updated ? `aktualizováno ${hhmm(d.updated)}${dayKey(d.updated) !== d.today ? ` (${longDay(d.updated)})` : ''}` : 'zatím bez dat'}</span></div>
      <h1>{h1[0].toUpperCase()}{h1.slice(1)}</h1>
      <p class="lead">{hub ? 'Fotbal, hokej, basketbal, volejbal a házená na jednom místě' : `${d.comps.slice(0, 3).map(compName).join(', ')}${d.comps.length > 3 ? ' a další soutěže' : ''}`}: skóre, stav zápasu a u odehraných zápasů průběh a statistiky.</p>
    </section>
    <nav class="chips" aria-label="Den">
      {days.map(([k, l]) => <a class="chip" href={href({ den: k })} aria-current={k === d.key ? 'page' : undefined}>{l}</a>)}
      <form method="get" action={d.base} class="res-date">
        <label><span class="sr">Vybrat datum</span><input type="date" name="den" value={d.key} min={d.minKey} max={d.maxKey} /></label>
        {d.comp ? <input type="hidden" name="soutez" value={d.comp} /> : null}
        {d.stav ? <input type="hidden" name="stav" value={d.stav} /> : null}
        <button class="chip" type="submit">Zobrazit</button>
      </form>
    </nav>
    <nav class="chips" aria-label="Sport">
      <a class="chip" href="/vysledky/" aria-current={hub ? 'page' : undefined}><Icon name="trophy" />Všechny sporty</a>
      {RESULT_SPORTS.map((s) => <a class="chip" href={`/vysledky/${s.slug}/`} aria-current={d.sport.slug === s.slug ? 'page' : undefined}><Icon name={s.slug} />{s.name}{hub ? <em>{d.sports.find((x) => x.slug === s.slug)?.n ?? 0}</em> : null}</a>)}
    </nav>
    <nav class="chips" aria-label="Soutěž" data-filter="c" hidden={hub}>
      <a class="chip" href={href({ soutez: '' })} data-v="" aria-current={!d.comp ? 'page' : undefined}>Všechny soutěže</a>
      {d.comps.map((c) => <a class="chip" href={href({ soutez: c })} data-v={c} aria-current={d.comp === c ? 'page' : undefined}>{compName(c)}<em>{d.all.filter((r) => r.comp === c).length}</em></a>)}
    </nav>
    <nav class="chips" aria-label="Stav zápasu" data-filter="g">
      {STAV_LABELS.map(([v, l]) => <a class="chip" href={href({ stav: v })} data-v={({ probiha: 'live', skonceno: 'final', nadchazejici: 'upcoming' } as Record<string, string>)[v] ?? ''} aria-current={d.stav === v ? 'page' : undefined}>{l}<em>{counts(v)}</em></a>)}
    </nav>
    {staleN ? <p class="res-warn" role="status">U {staleN} {plural(staleN, 'probíhajícího zápasu', 'probíhajících zápasů', 'probíhajících zápasů')} nepřišla aktualizace déle než {Math.round(d.staleMs / 60_000)} minut. Skóre může být zastaralé.</p> : null}
    <section class="sec" id="vysledky" data-day={d.key} data-live={isToday && live ? '1' : undefined}>
      <ResultsList rows={d.rows} comps={d.comps} now={now} staleMs={d.staleMs} empty={d.all.length ? 'Pro zvolený filtr tu nic není.' : `Pro ${isToday ? 'dnešek' : 'tento den'} nemáme v soutěžích ${comps} žádné zápasy.`} />
    </section>
    <div class="art-bonus"><Bonus placement="vysledky-bonus" /></div>
    <section class="sec prose">
      <h2>Jak výsledky čteme</h2>
      <p>U budoucích zápasů ukazujeme čas výkopu, skóre až po začátku. „Konec“ píšeme jen u zápasu, jehož konec máme potvrzený; než ho potvrdíme, uvidíš „Výsledek nepotvrzen“ s posledním známým skóre. Program dalších dnů najdeš v <a href="/program/">programu přenosů</a>, zápasy jednotlivých soutěží na stránkách {d.comps.map((c, i) => <>{i ? (i === d.comps.length - 1 ? ' a ' : ', ') : ''}<a href={compPath(c)}>{compName(c)}</a></>)}.</p>
    </section>
  </div>
</Base>
<script>
  // Filters without a reload (the chips are ordinary links and work without JavaScript too).
  const sec = document.getElementById('vysledky');
  const state: Record<string, string> = {};
  document.querySelectorAll<HTMLElement>('[data-filter]').forEach((nav) => {
    const cur = nav.querySelector<HTMLElement>('[aria-current]');
    state[nav.dataset.filter!] = cur?.dataset.v ?? '';
    nav.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-v]');
      if (!a || !sec || e.metaKey || e.ctrlKey) return;
      e.preventDefault();
      nav.querySelectorAll('a').forEach((x) => x.removeAttribute('aria-current'));
      a.setAttribute('aria-current', 'page');
      state[nav.dataset.filter!] = a.dataset.v ?? '';
      let shown = 0;
      sec.querySelectorAll<HTMLElement>('.row.res').forEach((r) => {
        const ok = (!state.c || r.dataset.c === state.c) && (!state.g || r.dataset.g === state.g);
        r.hidden = !ok;
        if (ok) shown++;
      });
      sec.querySelectorAll<HTMLElement>('.res-group').forEach((g) => { g.hidden = !g.querySelector('.row.res:not([hidden])'); });
      const none = sec.querySelector<HTMLElement>('.res-none');
      if (none) none.hidden = shown > 0 || !sec.querySelector('.row.res');
      history.replaceState(null, '', a.href);
    });
  });
  // Today with matches in play: re-read OUR stored scores every 60 s while the tab is visible (never the provider).
  if (sec?.dataset.live) {
    setInterval(async () => {
      if (document.hidden) return;
      try {
        const d: Record<string, [string, string, string, string]> = await (await fetch(`/api/vysledky.json?den=${sec.dataset.day}`)).json();
        sec.querySelectorAll<HTMLElement>('.row.res[data-rid]').forEach((r) => {
          const v = d[r.dataset.rid!];
          if (!v) return;
          const [short, label, score, minute] = v;
          const set = (sel: string, t: string) => { const n = r.querySelector(sel); if (n && t) n.textContent = t; };
          set('[data-st]', short);
          set('[data-sl]', label);
          set('[data-s]', score);
          set('[data-t]', minute);
        });
      } catch { /* keep what is on screen */ }
    }, 60_000);
  }
</script>
