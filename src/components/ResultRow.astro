---
import type { ResultRow } from '../lib/results/store';
import { group, statusLabel, statusShort } from '../lib/results/status';
import { resultPath, scoreText, isStale, compName, detailOf, scorers, asMatch } from '../lib/results/view';
import { goPath } from '../lib/url';
import Icon from './Icon.astro';
import EventIcon from './EventIcon.astro';
import { hhmm, shortDay, dayKey } from '../lib/text';
/** One match in the results lists. Status is always written out, never only a colour; a missing score is "–", never 0:0. */
interface Props { r: ResultRow; now: number; staleMs: number; showComp?: boolean; showDay?: boolean }
const { r, now, staleMs, showComp = false, showDay = false } = Astro.props;
const g = group(r.status);
const sc = scoreText(r);
const stale = isStale(r, now, staleMs);
const label = statusLabel(r.status, r.status_raw, r.sport);
const red = scorers(detailOf(r));
---
<div class:list={['row', 'res', g === 'live' && 'is-live', g === 'final' && 'is-final']} data-g={g} data-c={r.comp} data-rid={r.ext_id}>
  <div class="when">
    {r.status === 'scheduled' ? hhmm(r.start_utc) : <span data-st>{g === 'final' ? <Icon name="check" /> : null}{statusShort(r.status, r.sport)}</span>}
    {r.status !== 'scheduled' ? <small>{showDay && dayKey(r.start_utc) !== dayKey(now) ? shortDay(r.start_utc) : hhmm(r.start_utc)}</small> : showDay && dayKey(r.start_utc) !== dayKey(now) ? <small>{shortDay(r.start_utc)}</small> : null}
  </div>
  <div style="min-width:0">
    <div class="meta">
      <span class="sp" data-sl>{label}</span>
      {g === 'live' && r.minute_raw ? <span class="ti" data-t>{r.minute_raw}</span> : null}
      {r.pen_h != null && r.pen_a != null ? <span class="ti">pen. {r.pen_h}:{r.pen_a}</span> : null}
      {showComp ? <span class="lg">{compName(r.comp)}</span> : null}
      {stale ? <span class="novid" title="Zdroj tento zápas delší dobu nepotvrdil">aktualizace {hhmm(r.checked_at)}</span> : null}
    </div>
    <a class="tm" href={resultPath(r)}>{r.home}{red.redH ? <span class="reds" title={`Červené karty: ${red.redH}`}>{Array.from({ length: red.redH }, () => <EventIcon kind="red" label="Červená karta" />)}</span> : null} – {r.away}{red.redA ? <span class="reds" title={`Červené karty: ${red.redA}`}>{Array.from({ length: red.redA }, () => <EventIcon kind="red" label="Červená karta" />)}</span> : null}</a>
  </div>
  <div class="act">
    {r.stream && (g === 'upcoming' || g === 'live') ? <a class="btn sm v" href={goPath(asMatch(r), 'vysledky')} rel="sponsored nofollow noopener" target="_blank" aria-label={`Sledovat ${r.home} – ${r.away} u Tipsportu`}><Icon name="play" /><span class="lbl">Sledovat</span></a> : null}
    {sc ? <div class="score" data-s aria-label={`Skóre ${sc}`}>{sc}</div> : r.status !== 'scheduled' ? <div class="score muted" data-s aria-label="Skóre není k dispozici">–</div> : null}
  </div>
</div>
