---
import type { Match } from '../lib/types';
import { hhmm, shortDay, dayKey } from '../lib/text';
import { goPath, matchPath, matchTitle, sportOf } from '../lib/url';
import { competitionOf } from '../lib/competitions';
import Icon from './Icon.astro';
interface Props { m: Match; now: number; placement?: string; showDay?: boolean; live?: boolean; recent?: boolean }
const { m, now, placement = 'row', showDay = false, live = false, recent = false } = Astro.props;
const sport = sportOf(m);
const comp = competitionOf(m.sp, m.lg);
const o = m.o?.t;
---
<div class:list={['row', live && 'is-live']} data-id={m.id}>
  <div class="when">
    {live ? <span class="tag-live"><span class="dot"></span>Živě</span> : hhmm(m.st)}
    {!live && recent ? <small>záznam</small> : !live && showDay && dayKey(m.st) !== dayKey(now) ? <small>{shortDay(m.st)}</small> : null}
  </div>
  <div style="min-width:0">
    <div class="meta">
      <Icon name={sport?.slug ?? 'ball'} />
      <span class="sp">{sport?.name}</span>
      {live ? <span class="ti" data-t>{m.ti ?? ''}</span> : null}
      <span class="lg">{comp?.name ?? m.lg}</span>
      {!m.stream ? <span class="novid" title="Tipsport k zápasu nenabízí video, jen živé statistiky">stats</span> : null}
    </div>
    <a class="tm" href={matchPath(m)}>{matchTitle(m)}</a>
  </div>
  <div class="act">
    {live && m.sc ? <div class="score" data-s>{m.sc}</div> : null}
    {o && !live ? (
      <div class="odds" aria-label="Kurzy Tipsport">
        <span class="odd"><i>1</i>{o[0].toFixed(2)}</span>
        {o[1] !== null ? <span class="odd"><i>X</i>{o[1].toFixed(2)}</span> : null}
        <span class="odd"><i>2</i>{o[2].toFixed(2)}</span>
      </div>
    ) : null}
    <a class="btn sm" href={goPath(m, placement)} rel="sponsored nofollow noopener" target="_blank" aria-label={`Sledovat ${matchTitle(m)} u Tipsportu`}>
      <Icon name="play" /><span class="lbl">Sledovat</span>
    </a>
  </div>
</div>
