---
import type { Match } from '../lib/types';
import { hhmm, dayLabel } from '../lib/text';
import { goPath, sportOf } from '../lib/url';
import { competitionOf } from '../lib/competitions';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
/** The "player": the whole frame is one link to the match at Tipsport (where the real stream plays after login). */
interface Props { m: Match; state: 'live' | 'pre' | 'recent'; now: number }
const { m, state, now } = Astro.props;
const s = sportOf(m);
---
<a class="stage" href={goPath(m, 'player')} rel="sponsored nofollow noopener" target="_blank" data-id={m.id}>
  <Photo sport={s?.slug} eager sizes="(min-width: 1000px) 860px, 100vw" />
  <div class="in">
    <div class="hd">
      <span>{state === 'live' ? <span class="tag-live" style="color:#ff6b5e"><span class="dot"></span>Živě{m.ti ? <span data-t> · {m.ti}</span> : null}</span> : state === 'recent' ? 'Záznam' : `${dayLabel(m.st, now)} · ${hhmm(m.st)}`}</span>
      <span>{competitionOf(m.sp, m.lg)?.name ?? m.lg}</span>
    </div>
    <div class="mid">
      <span class="side">{m.h}</span>
      <div>
        <span class="play"><Icon name="play" /><span class="sr">Spustit přenos u Tipsportu</span></span>
        {state === 'live' && m.sc ? <div class="score" data-s>{m.sc}</div> : null}
        {state === 'pre' ? <div class="cd" data-cd={m.st}>Začíná v {hhmm(m.st)}</div> : null}
      </div>
      <span class="side b">{m.a}</span>
    </div>
    <div class="ft">
      <Icon name="play" />
      <span class="bar-fake"><i></i></span>
      <span>{m.stream ? 'HD přenos' : 'Živé statistiky'} · Tipsport</span>
    </div>
  </div>
</a>
<script>
  // Countdown to kick-off ("Začíná za 2 h 14 min"), refreshed every 20 s; nothing to do once it has started.
  const el = document.querySelector<HTMLElement>('[data-cd]');
  if (el) {
    const st = Number(el.dataset.cd);
    const tick = () => {
      const s = Math.round((st - Date.now()) / 1000);
      if (s <= 0) { el.textContent = 'Právě začíná – klikni a sleduj'; return; }
      const h = Math.floor(s / 3600), mi = Math.floor((s % 3600) / 60);
      el.textContent = h >= 24 ? el.textContent! : `Začíná za ${h ? `${h} h ` : ''}${mi} min`;
    };
    tick();
    setInterval(tick, 20_000);
  }
</script>
