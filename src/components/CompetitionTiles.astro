---
import type { League } from '../lib/page';
import { SPORT_BY_ID } from '../lib/sports';
import { plural } from '../lib/text';
interface Props { items: League[] }
const { items } = Astro.props;
const short = (n: string) => n.replace(/[^\p{L}\d ]/gu, '').split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
---
<div class="tiles">
  {items.map((l) => {
    const s = SPORT_BY_ID.get(l.sp)!;
    return (
      <a class="tile" href={`/${s.slug}-online/${l.slug}/`}>
        <span class="badge" style={`background:${l.color ?? '#2a332e'}`}>{l.short ?? short(l.name)}</span>
        <span><b>{l.name}</b><small>{s.name} · {l.n}<span class="w"> {plural(l.n, 'přenos', 'přenosy', 'přenosů')}</span></small></span>
        {l.live ? <span class="dot" title={`${l.live} živě`}></span> : null}
      </a>
    );
  })}
</div>
