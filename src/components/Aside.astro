---
import type { SportCount, League } from '../lib/page';
import { sportPath } from '../lib/url';
import { SPORT_BY_ID } from '../lib/sports';
import Bonus from './Bonus.astro';
import Icon from './Icon.astro';
import BannerSlot from './BannerSlot.astro';
import { bannerFor } from '../lib/banners';
interface Props { sports: SportCount[]; leagues: League[]; placement: string; sport?: string; comp?: string }
const { sports, leagues, placement, sport, comp } = Astro.props;
---
<aside class="aside">
  <BannerSlot banner={bannerFor(sport, comp)} placement={placement}><Bonus placement={placement} /></BannerSlot>
  {leagues.length ? (
    <div class="panel">
      <h3>Soutěže</h3>
      <ul class="list">
        {leagues.slice(0, 10).map((l) => <li><a href={`/${SPORT_BY_ID.get(l.sp)!.slug}-online/${l.slug}/`}><span class="lead"><span>{l.name}</span></span><em>{l.live ? <b>{l.live} živě · </b> : null}{l.n}</em></a></li>)}
      </ul>
    </div>
  ) : null}
  <div class="panel">
    <h3>Sporty</h3>
    <ul class="list">
      {sports.map((s) => <li><a href={sportPath(s.slug)}><span class="lead"><Icon name={s.slug} /><span>{s.name}</span></span><em>{s.live ? <b>{s.live} živě · </b> : null}{s.total}</em></a></li>)}
    </ul>
  </div>
</aside>
