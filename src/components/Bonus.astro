---
import { BONUS } from '../lib/bonus';
interface Props { placement: string }
const { placement } = Astro.props;
---
<div class="ticket">
  <span class="ad">Reklama</span>
  <div class="k">Bonus pro nové hráče · {BONUS.book}</div>
  <div class="amt">{BONUS.amount}</div>
  <p>Zaregistruj se u Tipsportu, sleduj stovky přenosů a k tomu bonus na první sázky.</p>
  <a class="btn lg" href={`/go/registrace/?p=${placement}`} rel="sponsored nofollow noopener" target="_blank">{BONUS.cta} zdarma</a>
  <small>{BONUS.terms} {BONUS.warn}</small>
</div>
