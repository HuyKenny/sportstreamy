---
import Icon from './Icon.astro';
import Search from './Search.astro';
import { NAV_MAIN, NAV_SPORTS, NAV_COMPS, NAV_MORE } from '../lib/menu';
import { BONUS } from '../lib/bonus';
/** Phone menu (the top navigation is hidden under 900 px): a modal sheet opened from the header or the dock. */
interface Props { results: boolean; section?: string }
const { results, section = '' } = Astro.props;
const main = [...NAV_MAIN.filter((n) => results || n.k !== 'vysledky'), NAV_MORE[2].items[0], { href: '/sazkove-kancelare/', label: 'Sázkové kanceláře a bonusy', k: 'bonusy', icon: 'gift' }, { href: '/clanky/', label: 'Články a návody', k: 'clanky', icon: 'arrow' }];
---
<dialog class="mmenu" id="mmenu" aria-label="Menu">
  <div class="mm-head">
    <b>Menu</b>
    <button type="button" class="mm-close" data-mm-close aria-label="Zavřít menu">✕</button>
  </div>
  <div class="mm-search"><Search id="mmq" /></div>
  <a class="btn lg mm-cta" href="/go/registrace/?p=menu" rel="sponsored nofollow noopener" target="_blank"><Icon name="gift" />Bonus {BONUS.amount} za registraci</a>
  <small class="mm-ad">Reklama · Tipsport · 18+</small>
  <nav aria-label="Sekce">
    <ul class="mm-list">
      {main.map((n) => <li><a href={n.href} aria-current={section === n.k ? 'page' : undefined}><Icon name={n.icon ?? "arrow"} />{n.label}</a></li>)}
    </ul>
    <p class="mm-k">Sporty</p>
    <ul class="mm-sports">
      {[...NAV_SPORTS, ...NAV_MORE[0].items].map((n) => <li><a href={n.href} aria-current={section === n.k ? 'page' : undefined}><Icon name={n.icon ?? 'ball'} />{n.label}</a></li>)}
    </ul>
    <p class="mm-k">Soutěže</p>
    <ul class="mm-sports">
      {[...NAV_COMPS, ...NAV_MORE[1].items.slice(0, 4)].map((n) => <li><a href={n.href} aria-current={section === n.k ? 'page' : undefined}>{n.label}</a></li>)}
    </ul>
    <p class="mm-k">Kde sledovat a sázet</p>
    <ul class="mm-list">
      {NAV_MORE[2].items.slice(1).concat({ href: '/pobocky/', label: 'Pobočky sázkových kanceláří', k: 'pobocky', icon: 'home' }).map((n) => <li><a href={n.href}><Icon name={n.icon ?? 'tv'} />{n.label}</a></li>)}
    </ul>
  </nav>
</dialog>
<script>
  // Native modal dialog: focus stays inside, Esc closes; a tap on the backdrop closes too.
  const dlg = document.getElementById('mmenu') as HTMLDialogElement | null;
  if (dlg) {
    document.querySelectorAll<HTMLElement>('[data-mm-open]').forEach((b) => b.addEventListener('click', () => {
      dlg.showModal();
      b.setAttribute('aria-expanded', 'true');
    }));
    dlg.addEventListener('close', () => document.querySelectorAll('[data-mm-open]').forEach((b) => b.setAttribute('aria-expanded', 'false')));
    dlg.querySelector('[data-mm-close]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  }
</script>
