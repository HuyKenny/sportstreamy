---
import Base from '../layouts/Base.astro';
import Rows from '../components/Rows.astro';
import { getEnv, view } from '../lib/page';
export const prerender = false;
const v = await view(getEnv());
Astro.response.status = 404;
---
<Base title="Zápas už není v nabídce | SportStreamy" description="Tenhle zápas už skončil nebo není v nabídce." noindex ttl={300}>
  <div class="wrap">
    <section class="hero"><h1>Tenhle zápas už skončil</h1><p class="lead">Podívej se, co běží teď.</p></section>
    <section class="sec"><Rows items={v.live} now={Date.now()} placement="gone" live limit={10} empty="Právě teď nic neběží, mrkni na program." /></section>
    <p><a class="btn" href="/program/">Program přenosů</a></p>
  </div>
</Base>
