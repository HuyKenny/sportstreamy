---
import Base from '../layouts/Base.astro';
import Rows from '../components/Rows.astro';
import Aside from '../components/Aside.astro';
import Carousel from '../components/Carousel.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import { getEnv, view, featured, tier, mixSports, sportCounts, leagues } from '../lib/page';
import { plural, hhmm } from '../lib/text';
import { breadcrumbLd, itemListLd } from '../lib/seo';
import { sportOf } from '../lib/url';

export const prerender = false;
const v = await view(getEnv());
const now = Date.now();
const sports = sportCounts(v);
const groups = sports.filter((s) => s.live).map((s) => ({ ...s, items: v.live.filter((m) => m.sp === s.id) }));
const slides = mixSports(featured(v.live.filter((m) => m.stream && tier(m) < 2)), 9);
const next = featured(v.upcoming).slice(0, 10).sort((a, b) => a.st - b.st);
const crumbs = [{ name: 'Domů', href: '/' }, { name: 'Živé přenosy' }];
---
<Base title={`Živé přenosy právě teď (${v.live.length}) – sport online | SportStreamy`} description={`Právě běží ${v.live.length} ${plural(v.live.length, 'přenos', 'přenosy', 'přenosů')} v ${groups.length} ${plural(groups.length, 'sportu', 'sportech', 'sportech')}. Živé skóre a odkaz na přenos, aktualizováno ${hhmm(now)}.`} ld={[breadcrumbLd(crumbs), itemListLd(v.live, 'Živé přenosy právě teď')]} section="zive" ttl={45} lcp={slides[0] ? sportOf(slides[0])?.slug : undefined}>
  <div class="wrap">
    <Crumbs items={crumbs} />
    <section class="pagehead">
      <div class="kicker"><span class="tag-live"><span class="dot"></span>Živě</span><span>· aktualizováno {hhmm(now)}</span></div>
      <h1>Živé přenosy právě teď</h1>
      <p class="lead">{v.live.length ? `Běží ${v.live.length} ${plural(v.live.length, 'zápas', 'zápasy', 'zápasů')} v ${groups.length} ${plural(groups.length, 'sportu', 'sportech', 'sportech')}. Skóre se obnovuje každých 30 sekund.` : 'Právě teď žádný zápas neběží, nejbližší začátky jsou níže.'}</p>
    </section>
    <div class="chips">
      {groups.map((g) => <a class="chip" href={`#${g.slug}`}><Icon name={g.slug} />{g.name}<em>{g.live}</em></a>)}
    </div>
    {slides.length ? <section class="sec"><Carousel items={slides} placement="zive-carousel" eagerFirst /></section> : null}
    <div class="cols">
      <div>
        {groups.map((g) => (
          <section class="sec" id={g.slug}>
            <div class="sec-head"><h2>{g.name} živě</h2><a href={`/${g.slug}-online/`}>{g.name} online ›</a></div>
            <Rows items={g.items} now={now} placement="zive" live />
          </section>
        ))}
        {v.recent.length ? (
          <section class="sec"><div class="sec-head"><h2>Právě skončilo</h2></div><Rows items={v.recent.slice(0, 8)} now={now} placement="zive-recent" recent /></section>
        ) : null}
        <section class="sec"><div class="sec-head"><h2>Začíná brzy</h2><a href="/program/">Program ›</a></div><Rows items={next} now={now} placement="zive-next" /></section>
      </div>
      <Aside sports={sports} leagues={leagues(v)} placement="zive-aside" />
    </div>
  </div>
</Base>
