---
import Base from '../../layouts/Base.astro';
import Rows from '../../components/Rows.astro';
import Aside from '../../components/Aside.astro';
import { kurzyCompetitionUrl, ziveCompetitionUrl, alkoholickyCompetitionUrl } from '../../lib/sister';
import Faq from '../../components/Faq.astro';
import Photo from '../../components/Photo.astro';
import Crumbs from '../../components/Crumbs.astro';
import { getEnv, view, sportCounts, leagues } from '../../lib/page';
import { SPORT_BY_SLUG } from '../../lib/sports';
import { competitionBySlug, competitionSlug } from '../../lib/competitions';
import { photoFor } from '../../lib/photos';
import { plural, hhmm, longDay, dayKey } from '../../lib/text';
import { breadcrumbLd, faqLd, itemListLd } from '../../lib/seo';
import ResultRow from '../../components/ResultRow.astro';
import { resultsConfig, resultsDb } from '../../lib/results/config';
import { recentOfComp } from '../../lib/results/store';

export const prerender = false;
const raw = Astro.params.sport ?? '';
const sport = raw.endsWith('-online') ? SPORT_BY_SLUG.get(raw.slice(0, -7)) : undefined;
if (!sport) return Astro.rewrite('/404/');
const slug = Astro.params.league ?? '';
// A curated slug belongs to one sport ("liga-mistru" is football); other sports' "Liga mistrů" stays uncurated.
const curated = competitionBySlug(slug);
const comp = curated?.sp === sport.id ? curated : undefined;
const v = await view(getEnv());
const now = Date.now();
const inComp = (m: { sp: number; lg: string }) => m.sp === sport.id && competitionSlug(m.sp, m.lg) === slug;
const live = v.live.filter(inComp);
const next = v.upcoming.filter(inComp);
// Uncurated competitions exist only while Tipsport lists them; curated ones always render.
// A competition that Tipsport dropped (ITF week, esports league) sends visitors to its sport page, not to a 404. 302: it can come back.
if (!comp && !live.length && !next.length) return Astro.redirect(`/${sport.slug}-online/`, 302);
const name = comp?.name ?? (live[0] ?? next[0]).lg;
// Results pilot: the latest results belong on this page, not on a second competition page under /vysledky/.
const rcfg = resultsConfig(getEnv());
const rdb = comp && rcfg.comps.includes(comp.slug) ? resultsDb(getEnv()) : null;
const results = rdb ? await recentOfComp(rdb, comp!.slug, now, 10) : [];
// Generic names ("Finská liga") repeat across sports — uncurated titles carry the sport.
const label = comp ? name : `${name} (${sport.name.toLowerCase()})`;
const total = live.length + next.length;
const todayN = live.length + next.filter((m) => dayKey(m.st) === dayKey(now)).length;
const photo = photoFor(sport.slug);
const crumbs = [{ name: 'Domů', href: '/' }, { name: `${sport.name} online`, href: `/${sport.slug}-online/` }, { name }];
const first = next[0];
const faq = [
  { q: `Kde sledovat ${name} online?`, a: `Zápasy soutěže ${name} najdeš v přehledu níže. Tlačítko „Sledovat“ tě přesune na zápas u Tipsportu, kde po přihlášení spustíš přenos${comp && !live.concat(next).some((m) => m.stream) ? ' nebo živé statistiky' : ''}.` },
  { q: `Kdy se hraje další zápas – ${name}?`, a: first ? `Nejbližší zápas je ${first.h}${first.a ? ' – ' + first.a : ''}, ${longDay(first.st)} v ${hhmm(first.st)}.` : 'Další zápasy zatím nejsou v nabídce. Program se doplňuje průběžně, obvykle týden dopředu.' },
  { q: 'Je sledování zdarma?', a: 'Pro registrované zákazníky Tipsportu ano. Registrace je bezplatná, sázení dobrovolné a jen od 18 let.' },
];
---
<Base title={comp ? `${name} dnes a živě – program a přenosy | SportStreamy` : `${label} živě – program a přenosy | SportStreamy`} description={`${name} dnes: ${todayN} ${plural(todayN, 'zápas', 'zápasy', 'zápasů')} (${live.length} živě), ${next.length} v programu. ${comp ? comp.intro.split('. ')[0] + '.' : `Zápasy soutěže ${name} s časem a kurzy.`}`.slice(0, 158)} ld={[breadcrumbLd(crumbs), faqLd(faq), itemListLd([...live, ...next], name)]} section={comp?.slug ?? sport.slug} noindex={!comp && total < 2} lcp={sport.slug}>
  <section class="hero">
    <Photo sport={sport.slug} eager alt={photo.alt} />
    <div class="wrap">
      <Crumbs items={crumbs} />
      <div style="display:flex;align-items:center;gap:14px;margin-top:14px">
        {comp ? <span class="badge" style={`background:${comp.color};width:56px;height:56px;font-size:1.1rem`}>{comp.short}</span> : null}
        <h1>{label} živě</h1>
      </div>
      <p class="lead">{comp?.intro ?? `${total} ${plural(total, 'zápas', 'zápasy', 'zápasů')} soutěže ${name} s přenosem nebo živými statistikami.`}</p>
      {comp?.guide ? <p style="margin:10px 0 0"><a class="btn" href={comp.guide.href}>{comp.guide.label} ›</a></p> : null}
      {comp && kurzyCompetitionUrl(comp.slug) ? <p class="muted" style="margin:10px 0 0;font-size:.9rem">Kurzy na zápasy {name} a jejich vývoj porovnává náš sesterský web <a href={kurzyCompetitionUrl(comp.slug)!}>KurzovýRadar</a>.</p> : null}
      {comp && ziveCompetitionUrl(comp.slug) ? <p class="muted" style="margin:6px 0 0;font-size:.9rem">Divákům ze Slovenska ukazuje program {name} náš slovenský web <a href={ziveCompetitionUrl(comp.slug)!}>ŽivéPrenosy.sk</a>.</p> : null}
      {comp && alkoholickyCompetitionUrl(comp.slug) ? <p class="muted" style="margin:6px 0 0;font-size:.9rem">K hokeji doma se hodí i něco k pití, třeba <a href={alkoholickyCompetitionUrl(comp.slug)!}>nealkoholická piva</a> porovnaná v e-shopech na Alkoholicky.cz.</p> : null}
      <div class="stats"><div class:list={["live", !live.length && "zero"]}>{live.length}<span>živě teď</span></div><div>{next.length}<span>v programu</span></div></div>
    </div>
    <a class="credit" href={photo.url} rel="noopener nofollow">Foto: {photo.author} / Pexels</a>
  </section>
  <div class="wrap">
    <div class="cols">
      <div>
        {live.length ? (<section class="sec zone live"><div class="sec-head"><h2>Živě <span class="cnt live">{live.length}</span></h2></div><Rows items={live} now={now} placement="league-live" live /></section>) : null}
        <section class="sec"><div class="sec-head"><h2>Program</h2><span class="n">{next.length}</span></div><Rows items={next} now={now} placement="league" groupByDay empty={`Další zápasy soutěže ${name} zatím nejsou v nabídce. Program se doplňuje průběžně, obvykle týden dopředu.`} /></section>
        {results.length ? (<section class="sec"><div class="sec-head"><h2>Výsledky · {name}</h2><a href={`/vysledky/?soutez=${comp!.slug}`}>Všechny výsledky ›</a></div><div class="rows">{results.map((r) => <ResultRow r={r} now={now} staleMs={rcfg.staleMs} showDay />)}</div></section>) : null}
        <section class="sec"><div class="sec-head"><h2>Časté otázky</h2></div><Faq items={faq} /></section>
      </div>
      <Aside sports={sportCounts(v)} leagues={leagues(v, sport.id)} placement="league-aside" sport={sport.slug} comp={slug} />
    </div>
  </div>
</Base>
