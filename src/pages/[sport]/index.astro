---
import Base from '../../layouts/Base.astro';
import ListHint from '../../components/ListHint.astro';
import Rows from '../../components/Rows.astro';
import Aside from '../../components/Aside.astro';
import Faq from '../../components/Faq.astro';
import Photo from '../../components/Photo.astro';
import Crumbs from '../../components/Crumbs.astro';
import CompetitionTiles from '../../components/CompetitionTiles.astro';
import { getEnv, view, featured, sportCounts, leagues } from '../../lib/page';
import { SPORT_BY_SLUG } from '../../lib/sports';
import { COMPETITIONS } from '../../lib/competitions';
import { sportLead, sportBody, sportFaq, TODAY_SPORTS } from '../../lib/sport-text';
import SportToday from '../../components/SportToday.astro';
import { photoFor } from '../../lib/photos';
import { plural } from '../../lib/text';
import { breadcrumbLd, faqLd, itemListLd } from '../../lib/seo';
import { resultsConfig } from '../../lib/results/config';
import { RESULT_SPORTS, compsOf } from '../../lib/results/page';

export const prerender = false;
const raw = Astro.params.sport ?? '';
// /{sport}-online/ = week hub, /{sport}-dnes/ = today only (separate search intent: "hokej dnes" 62k/month)
const mode = raw.endsWith('-online') ? 'online' : raw.endsWith('-dnes') ? 'dnes' : '';
const sport = mode ? SPORT_BY_SLUG.get(raw.replace(/-(online|dnes)$/, '')) : undefined;
if (!sport || (mode === 'dnes' && !TODAY_SPORTS.has(sport.slug))) return Astro.rewrite('/404/');
const v = await view(getEnv());
const rc = resultsConfig(getEnv());
const resultsSport = rc.enabled ? RESULT_SPORTS.find((s) => s.id === sport.id && compsOf(rc.comps, s.id).length) : undefined;
const now = Date.now();
const live = v.live.filter((m) => m.sp === sport.id);
const next = v.upcoming.filter((m) => m.sp === sport.id);
const lg = leagues(v, sport.id);
// Curated competitions of this sport are always linked (stable pages), even with nothing scheduled.
const curated = COMPETITIONS.filter((c) => c.sp === sport.id).map((c) => lg.find((l) => l.slug === c.slug) ?? { name: c.name, slug: c.slug, sp: c.sp, n: 0, live: 0, top: !!c.top, short: c.short, color: c.color });
const others = lg.filter((l) => !curated.some((c) => c.slug === l.slug)).slice(0, 12);
const faq = sportFaq(sport, live.length > 0);
const photo = photoFor(sport.slug);
const crumbs = [{ name: 'Domů', href: '/' }, { name: `${sport.name} online` }];
const body = sportBody(sport);
const LIMIT = 40;
const shown = next.length > LIMIT ? featured(next).slice(0, LIMIT).sort((a, b) => a.st - b.st) : next;
---
{mode === 'dnes' ? <SportToday sport={sport} v={v} /> : (
<Base title={`${sport.name} online zdarma – živé přenosy dnes | SportStreamy`} description={`${sport.name} online: ${live.length} ${plural(live.length, 'zápas', 'zápasy', 'zápasů')} živě, ${next.length} v programu na 7 dní. Čas, soutěž, kurzy a odkaz na přenos zdarma.`} ld={[breadcrumbLd(crumbs), faqLd(faq), itemListLd([...live, ...next], `${sport.name} online`)]} section={sport.slug} lcp={sport.slug}>
  <section class="hero">
    <Photo sport={sport.slug} eager alt={photo.alt} />
    <div class="wrap">
      <Crumbs items={crumbs} />
      <h1 style="margin-top:14px">{sport.name} online</h1>
      <p class="lead">{sportLead(sport)}</p>
      {TODAY_SPORTS.has(sport.slug) ? <p style="margin-top:12px"><a class="btn sm ghost" href={`/${sport.slug}-dnes/`}>{sport.genitive === 'fotbalu' ? 'Fotbal' : sport.name} dnes ›</a></p> : null}
      <div class="stats">
        <div class:list={["live", !live.length && "zero"]}>{live.length}<span>živě teď</span></div>
        <div>{next.length}<span>v programu</span></div>
        <div>{lg.length}<span>{plural(lg.length, 'soutěž', 'soutěže', 'soutěží')}</span></div>
      </div>
    </div>
    <a class="credit" href={photo.url} rel="noopener nofollow">Foto: {photo.author} / Pexels</a>
  </section>
  <div class="wrap">
    {others.length ? <div class="chips" aria-label="Další soutěže" style="margin-top:14px">{others.map((l) => <a class="chip" href={`/${sport.slug}-online/${l.slug}/`}>{l.name}<em>{l.n}</em></a>)}</div> : null}
    <div class="cols">
      <div>
        <ListHint placement={`sport-${sport.slug}`} />
        {live.length ? (<section class="sec zone live"><div class="sec-head"><h2>{sport.name} živě <span class="cnt live">{live.length}</span></h2></div><Rows items={live} now={now} placement="sport-live" live /></section>) : null}
        {curated.length ? <section class="sec zone"><div class="sec-head"><h2>Soutěže</h2></div><CompetitionTiles items={curated} /></section> : null}
        {resultsSport ? <p class="more" style="margin:0 0 12px"><a href={`/vysledky/${resultsSport.slug}/`}>Výsledky {resultsSport.genitive} dnes a včera ›</a></p> : null}
        <section class="sec"><div class="sec-head"><h2>Program</h2><span class="n">{next.length}</span></div><Rows items={shown} now={now} placement="sport" groupByDay empty="Zatím žádné naplánované přenosy." />{next.length > shown.length ? <p class="more"><a href={`/program/?sport=${sport.slug}`}>Další zápasy po dnech – {sport.name.toLowerCase()} ›</a></p> : null}</section>
        {body ? <section class="sec prose" set:html={body} /> : null}
        <section class="sec"><div class="sec-head"><h2>Časté otázky</h2></div><Faq items={faq} /></section>
      </div>
      <Aside sports={sportCounts(v)} leagues={lg} placement="sport-aside" sport={sport.slug} />
    </div>
  </div>
</Base>
)}
