---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import Crumbs from '../../components/Crumbs.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { breadcrumbLd, faqLd } from '../../lib/seo';
export const prerender = false;
const entry = await getEntry('clanky', Astro.params.slug!);
if (!entry) return Astro.rewrite('/404');
const { Content } = await render(entry);
const { title, description, date, updated, faq, related } = entry.data;
const fmt = new Intl.DateTimeFormat('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' });
const others = (await getCollection('clanky')).filter((a) => a.id !== entry.id);
const rel = [...(related ?? []).map((s) => others.find((a) => a.id === s)).filter((a) => !!a), ...others.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())]
  .filter((a, i, all) => all.indexOf(a) === i)
  .slice(0, 3);
const crumbs = [{ name: 'Domů', href: '/' }, { name: 'Články', href: '/clanky/' }, { name: title }];
const org = { '@type': 'Organization', name: 'SportStreamy', url: 'https://sportstreamy.cz/o-webu/' };
const ld = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: title, description, datePublished: date.toISOString(), dateModified: (updated ?? date).toISOString(), inLanguage: 'cs', author: org, publisher: org, mainEntityOfPage: `https://sportstreamy.cz/clanky/${entry.id}/` },
  breadcrumbLd(crumbs),
  ...(faq?.length ? [faqLd(faq)] : []),
];
---
<Base title={`${title} | SportStreamy`} description={description} ld={ld} section="clanky" ttl={600}>
  <div class="wrap">
    <Crumbs items={crumbs} />
    <article class="sec prose">
      <h1 style="margin-bottom:.3em">{title}</h1>
      <p class="muted" style="font-size:.85rem;margin-top:0">Redakce SportStreamy · {updated ? `aktualizováno ${fmt.format(updated)}` : fmt.format(date)}</p>
      <Content />
      {faq?.length ? <><h2>Časté otázky</h2><Faq items={faq} /></> : null}
      <p><a class="btn" href="/zive/">Co běží živě</a></p>
    </article>
    {rel.length ? <section class="sec"><div class="sec-head"><h2>Další články</h2><a href="/clanky/">Všechny ›</a></div><div class="cards">{rel.map((a) => <a class="card" href={`/clanky/${a.id}/`}><div><h3>{a.data.title}</h3><p>{a.data.description}</p></div></a>)}</div></section> : null}
  </div>
</Base>
