---
import Base from '../layouts/Base.astro';
import Rows from '../components/Rows.astro';
import Aside from '../components/Aside.astro';
import Faq from '../components/Faq.astro';
import Carousel from '../components/Carousel.astro';
import CompetitionTiles from '../components/CompetitionTiles.astro';
import Search from '../components/Search.astro';
import Icon from '../components/Icon.astro';
import { getEnv, view, featured, tier, mixSports, sportCounts, leagues } from '../lib/page';
import { dayKey, plural, hhmm } from '../lib/text';
import { sportPath, sportOf } from '../lib/url';
import { faqLd, itemListLd, siteLd } from '../lib/seo';
import { previews, previewPath } from '../lib/nahledy';
import ResultsList from '../components/ResultsList.astro';
import ListHint from '../components/ListHint.astro';
import { resultsConfig, resultsDb } from '../lib/results/config';
import { rowsBetween } from '../lib/results/store';
import { pragueDay } from '../lib/results/time';

export const prerender = false;
const v = await view(getEnv());
const now = Date.now();
const sports = sportCounts(v);
const lg = leagues(v);
const todayKey = dayKey(now);
const today = featured(v.upcoming.filter((m) => dayKey(m.st) === todayKey));
// The homepage list mixes sports (then goes back to time order), otherwise ATP/WTA fill all 15 rows.
const todayMix = mixSports(today, 15).sort((a, b) => a.st - b.st);
const later = featured(v.upcoming.filter((m) => dayKey(m.st) !== todayKey));
// Carousel: live matches with video from top competitions / main sports; fall back to the next big kick-offs.
const liveSlides = mixSports(featured(v.live.filter((m) => m.stream && tier(m) < 2)), 9);
const slides = [...liveSlides, ...mixSports(featured(v.upcoming.filter((m) => m.stream && tier(m) < 2)), 9 - liveSlides.length)];
const liveTop = v.live.slice(0, 12);
const faq = [
  { q: 'Dají se zápasy sledovat zdarma?', a: 'Ano. Přenosy vysílá Tipsport svým registrovaným zákazníkům a sledování je bezplatné – vsázet nemusíš. My videa nevysíláme, jen ukazujeme, co kde běží, a vedeme tě rovnou na správný zápas.' },
  { q: 'Odkud jsou data o zápasech a kurzech?', a: 'Program, živé skóre, výsledky a kurzy průběžně aktualizujeme z ověřených zdrojů sportovních dat. Skóre u běžících zápasů se na stránce obnovuje samo.' },
  { q: 'Proč se musím registrovat?', a: 'Provozovatel s českou licencí smí vysílat jen ověřeným zákazníkům starším 18 let. Registrace je bezplatná a noví hráči Tipsportu k ní dostávají bonus 1000 Kč.' },
  { q: 'Co znamená štítek „stats“?', a: 'K zápasu nemá Tipsport video (práva drží televize), ale nabízí živé statistiky, průběžné skóre a kurzy.' },
  { q: 'Jak najdu konkrétní tým?', a: 'Napiš jeho název do hledání nahoře – stačí část názvu a bez diakritiky. Uvidíš všechny jeho zápasy na 7 dní dopředu.' },
];
const ld = [...siteLd(), faqLd(faq), itemListLd([...v.live, ...today].slice(0, 20), 'Živé přenosy dnes')];
const big = (await previews({ upcoming: true })).slice(0, 4);
// Results pilot: today's started matches from the same stored data as /vysledky/ (nothing when the section is off).
const rcfg = resultsConfig(getEnv());
const rdb = resultsDb(getEnv());
const resultsToday = rdb ? (await rowsBetween(rdb, ...pragueDay(todayKey), rcfg.comps)).filter((r) => r.status !== 'scheduled').slice(-6) : [];
---
<Base title="Živé přenosy zdarma – sport online dnes | SportStreamy" description={`Živé přenosy zdarma: právě běží ${v.live.length} zápasů, dnes dalších ${today.length}. Fotbal, hokej, tenis, NBA i Chance Liga – najdi zápas a sleduj ho online.`} ld={ld} section="home" lcp={slides[0] ? sportOf(slides[0])?.slug : undefined} lcpSizes="(min-width: 900px) 400px, 86vw">
  <div class="wrap">
    <section class="pagehead">
      <div class="kicker"><span class="tag-live"><span class="dot"></span>{v.live.length} živě</span><span>· {today.length} dnes · aktualizováno {hhmm(v.at || now)}</span></div>
      <h1>Živé přenosy zdarma</h1>
      <p class="lead">Najdi zápas, klikni a sleduj. Fotbal, hokej, tenis, basketbal a dalších {Math.max(0, sports.length - 4)} sportů – program na 7 dní dopředu.</p>
      <div style="margin-top:14px;max-width:560px" class="hide-desk"><Search id="mq" /></div>
    </section>

    <div class="chips" aria-label="Sporty">
      <a class="chip" href="/zive/" aria-current="page"><Icon name="live" />Vše<em>{v.live.length + v.upcoming.length}</em></a>
      {sports.map((s) => <a class="chip" href={sportPath(s.slug)}><Icon name={s.slug} />{s.name}<em>{s.total}</em></a>)}
    </div>

    {slides.length ? (
      <div class="band">
        <section class="sec">
          <div class="sec-head"><h2>Sledujte teď</h2><a href="/zive/">Všechny živé ›</a></div>
          <Carousel items={slides} placement="carousel" eagerFirst />
        </section>
      </div>
    ) : null}

    <div class="cols">
      <div>
        <section class="sec zone live">
          <div class="sec-head"><h2>Živě právě teď <span class="cnt live">{v.live.length}</span></h2><a href="/zive/">Vše ›</a></div>
          <ListHint placement="home" />
          <Rows items={liveTop.length ? v.live : []} now={now} placement="home-live" live limit={12} more={{ href: '/zive/', label: 'Všechny živé přenosy' }} empty="Právě teď neběží žádný přenos – nejbližší začátky jsou níže." />
        </section>

        {big.length ? (
          <section class="sec">
            <div class="sec-head"><h2>Kde sledovat velké zápasy</h2><a href="/jak-sledovat/">Všechny ›</a></div>
            <div class="cards">{big.map((p) => <a class="card" href={previewPath(p)}><div><small style="color:var(--ink-2)">{p.data.league} · {hhmm(p.data.start.getTime())}</small><h3>{p.data.home} – {p.data.away}</h3><p>Kde sledovat, TV a kurzy</p></div></a>)}</div>
          </section>
        ) : null}
        {resultsToday.length ? (
          <section class="sec">
            <div class="sec-head"><h2>Výsledky dnes</h2><a href="/vysledky/">Všechny výsledky ›</a></div>
            <ResultsList rows={resultsToday} comps={rcfg.comps} now={now} staleMs={rcfg.staleMs} empty="" />
          </section>
        ) : null}
        <section class="sec zone">
          <div class="sec-head"><h2>Populární soutěže</h2><a href="/program/">Program ›</a></div>
          <CompetitionTiles items={lg.filter((l) => l.top).slice(0, 8)} />
        </section>

        <section class="sec">
          <div class="sec-head"><h2>Dnes <span class="cnt">{today.length}</span></h2><a href="/program/">Celý program ›</a></div>
          <div class="chips" aria-label="Dnes podle sportu" style="margin-bottom:10px"><a class="chip" href="/fotbal-dnes/">Fotbal dnes</a><a class="chip" href="/hokej-dnes/">Hokej dnes</a><a class="chip" href="/tenis-dnes/">Tenis dnes</a><a class="chip" href="/basketbal-dnes/">Basketbal dnes</a><a class="chip" href="/volejbal-dnes/">Volejbal dnes</a></div>
          <Rows items={todayMix} now={now} placement="home-today" more={{ href: '/program/', label: 'Celý dnešní program' }} empty="Na dnešek už nic nezbývá – mrkni na zítřek." />
        </section>

        <section class="sec">
          <div class="sec-head"><h2>Zítra a další dny</h2><a href="/program/zitra/">Zítra ›</a></div>
          <Rows items={mixSports(later, 12).sort((a, b) => a.st - b.st)} now={now} placement="home-next" groupByDay />
        </section>

        <section class="sec prose">
          <h2>Živé přenosy zdarma na jednom místě</h2>
          <p>SportStreamy hlídá program živých přenosů u největší české sázkové kanceláře a ukazuje ho přehledně na jednom místě: co právě běží, co začne dnes a co se hraje v dalších dnech. U každého zápasu vidíš čas, soutěž, kurzy a u běžících zápasů průběžné skóre. Tlačítkem „Sledovat“ se dostaneš přímo na zápas – bez hledání po webu provozovatele.</p>
          <h3>Nejsledovanější sporty</h3>
          <p>Nejvíc přenosů nabízí <a href="/fotbal-online/">fotbal online</a> a <a href="/tenis-online/">tenis online</a>, velký zájem je o <a href="/hokej-online/">hokej online</a> včetně <a href="/hokej-online/nhl/">NHL</a> a <a href="/hokej-online/tipsport-extraliga/">Tipsport extraligy</a>. Fanoušci českého fotbalu najdou všechna kola <a href="/fotbal-online/chance-liga/">Chance Ligy</a>, z Evropy pak <a href="/fotbal-online/liga-mistru/">Ligu mistrů</a> a <a href="/fotbal-online/premier-league/">Premier League</a>.</p>
          <h3>Jak sledovat zápas</h3>
          <p>Vyber zápas, klikni na „Sledovat“ a přihlas se u Tipsportu. Kdo ještě účet nemá, zaregistruje se za pár minut a jako nový hráč dostane <a href="/sazkove-kancelare/tipsport/">bonus 1000 Kč</a>. Přenos je pak dostupný zdarma, sázení je dobrovolné a jen pro plnoleté.</p>
        </section>
        <section class="sec"><div class="sec-head"><h2>Časté otázky</h2></div><Faq items={faq} /></section>
      </div>
      <Aside sports={sports} leagues={lg} placement="home-aside" />
    </div>
  </div>
</Base>
<style>
  @media (min-width: 760px) { .hide-desk { display: none; } }
</style>
