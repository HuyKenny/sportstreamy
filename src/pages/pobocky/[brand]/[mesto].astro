---
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import Faq from '../../../components/Faq.astro';
import { getEnv } from '../../../lib/page';
import { loadBranches, citiesOf, CITY_MIN, hoursText, mapLink } from '../../../lib/pobocky';
import { BOOKS, BOOK_BY_SLUG, ctaFor, type BookSlug } from '../../../lib/books';
import { BONUS } from '../../../lib/bonus';
import { breadcrumbLd, faqLd } from '../../../lib/seo';
export const prerender = false;
const b = BOOK_BY_SLUG.get(Astro.params.brand as BookSlug);
if (!b || !b.branches) return Astro.rewrite('/404/');
const doc = await loadBranches(getEnv());
const all = doc.brands[b.slug] ?? [];
const rows = all.filter((r) => r.citySlug === Astro.params.mesto);
if (rows.length < CITY_MIN) return Astro.rewrite('/404/');
const city = rows[0].city;
const withHours = rows.some((r) => r.hours.some(Boolean));
// Same city at the other brands — useful to people comparing shops and a natural internal link.
const siblings = BOOKS.filter((o) => o.branches && o.slug !== b.slug)
  .map((o) => ({ o, n: (doc.brands[o.slug] ?? []).filter((r) => r.citySlug === Astro.params.mesto).length }))
  .filter((x) => x.n > 0);
const parts = [...new Set(rows.map((r) => r.part).filter(Boolean))];
const inCity = city === 'Praha' ? 'v Praze' : `ve městě ${city}`;
const others = citiesOf(all).filter((c) => c.n >= CITY_MIN && c.slug !== Astro.params.mesto && c.region === rows[0].region).slice(0, 12);
const crumbs = [{ name: 'Domů', href: '/' }, { name: 'Pobočky', href: '/pobocky/' }, { name: `${b.short} pobočky`, href: `/pobocky/${b.slug}/` }, { name: city }];
const faq = [
  { q: `Kolik poboček má ${b.short} ${city === 'Praha' ? 'v Praze' : `ve městě ${city}`}?`, a: `Podle vyhledávače provozovatele ${rows.length}. Seznam s adresami${rows.some((r) => r.hours.some(Boolean)) ? ' a otevírací dobou' : ''} je výše.` },
  { q: 'Musím na pobočku, abych mohl sledovat zápas?', a: `Ne, přenosy a sázky fungují online. ${b.partner ? `Účet u ${b.gen} si založíš přes odkaz na této stránce.` : `S bonusem ${BONUS.amount} přes nás funguje Tipsport.`}` },
];
const ld = rows.map((r) => ({ '@context': 'https://schema.org', '@type': 'LocalBusiness', name: `${b.short} ${r.name}`, address: { '@type': 'PostalAddress', streetAddress: r.street, addressLocality: r.part || r.city, postalCode: r.zip, addressCountry: 'CZ' }, ...(r.lat != null ? { geo: { '@type': 'GeoCoordinates', latitude: r.lat, longitude: r.lon } } : {}), parentOrganization: { '@type': 'Organization', name: b.full } }));
---
<Base title={`${b.short} ${city} – pobočky${withHours ? ', adresy a otevírací doba' : ' a adresy'} (${rows.length}) | SportStreamy`} description={`${rows.length} poboček ${b.short} – ${city}: adresy${withHours ? ', otevírací doba' : ''} a navigace. ${rows.slice(0, 2).map((r) => r.street).join(', ')}…`} ld={[breadcrumbLd(crumbs), faqLd(faq), ...ld.slice(0, 30)]} section="bonusy" ttl={3600}>
  <div class="wrap">
    <Crumbs items={crumbs} />
    <section class="pagehead">
      <h1>{b.short} {city} – pobočky</h1>
      <p class="lead">{rows.length} poboček {b.short} – {city}. {withHours ? 'Otevírací dobu přebíráme z vyhledávače provozovatele; před návštěvou ji ověř.' : `Adresy přebíráme z vyhledávače provozovatele; otevírací dobu konkrétní pobočky najdeš na ${b.site.replace('https://www.', '')}/pobocky.`}</p>
      <div class="cta-row"><a class="btn" href={`${ctaFor(b)}?p=pobocky-mesto-${b.slug}`} rel="sponsored nofollow noopener" target="_blank">{b.partner ? `Sázej online u ${b.short}` : `Online s bonusem: Tipsport ${BONUS.amount}`}</a><span class="tag-ad">Reklama · 18+</span></div>
    </section>
    <section class="sec">
      <div class="rows">
        {rows.map((r) => (
          <div class="row" style="grid-template-columns:minmax(0,1fr) auto">
            <div style="min-width:0">
              <div class="meta"><span class="sp">{r.part || r.city}</span>{r.note ? <span class="lg">{r.note}</span> : null}{r.live ? <span class="novid">live sázky</span> : null}</div>
              <b class="tm" style="white-space:normal">{r.street}, {r.zip} {r.part || r.city}</b>
              {withHours ? <div class="muted" style="font-size:.84rem;margin-top:2px">{hoursText(r.hours) || 'Otevírací doba neuvedena'}</div> : null}
            </div>
            <div class="act"><a class="btn sm ghost nav" href={mapLink(r)} rel="nofollow noopener" target="_blank">Navigovat</a></div>
          </div>
        ))}
      </div>
    </section>
    <section class="sec prose">
      <h2>{b.short} {inCity}</h2>
      <p>{b.short} má {inCity} {rows.length} {rows.length < 5 ? 'pobočky' : 'poboček'}{parts.length > 1 ? `, rozmístěné v částech ${parts.slice(0, 8).join(', ')}${parts.length > 8 ? ' a dalších' : ''}` : ''}. Na pobočce podáš tiket, zkontroluješ ho a vyzvedneš výhru; u vyšších výher počítej s dokladem totožnosti. Jak zkontrolovat tiket online i z pobočky, popisuje návod <a href={`/sazkove-kancelare/${b.slug}/kontrola-tiketu/`}>{b.short} kontrola tiketu</a>.</p>
      {siblings.length ? <p>{city === 'Praha' ? 'V Praze' : `Ve městě ${city}`} najdeš i pobočky {siblings.map((x, i) => <>{i ? (i === siblings.length - 1 ? ' a ' : ', ') : ''}<a href={x.n >= CITY_MIN ? `/pobocky/${x.o.slug}/${Astro.params.mesto}/` : `/pobocky/${x.o.slug}/`}>{x.o.short}</a> ({x.n})</>)}.</p> : null}
      <p>Na pobočku nemusíš, pokud chceš jen sledovat zápasy: přenosy běží online pro registrované zákazníky – přehled je v <a href="/zive/">živých přenosech</a>.</p>
    </section>
    {others.length ? <section class="sec"><div class="sec-head"><h2>Další města v kraji</h2></div><div class="chips" style="flex-wrap:wrap">{others.map((c) => <a class="chip" href={`/pobocky/${b.slug}/${c.slug}/`}>{c.city}<em>{c.n}</em></a>)}</div></section> : null}
    <section class="sec"><div class="sec-head"><h2>Časté otázky</h2></div><Faq items={faq} /></section>
  </div>
</Base>
