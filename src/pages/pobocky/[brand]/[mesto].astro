---
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import Faq from '../../../components/Faq.astro';
import { getEnv } from '../../../lib/page';
import { loadBranches, citiesOf, CITY_MIN, hoursText, mapLink } from '../../../lib/pobocky';
import { BOOK_BY_SLUG, ctaFor, type BookSlug } from '../../../lib/books';
import { BONUS } from '../../../lib/bonus';
import { breadcrumbLd, faqLd } from '../../../lib/seo';
export const prerender = false;
const b = BOOK_BY_SLUG.get(Astro.params.brand as BookSlug);
if (!b || !b.branches) return Astro.rewrite('/404/');
const doc = await loadBranches(getEnv());
const all = doc.brands[b.slug] ?? [];
const rows = all.filter((r) => r.citySlug === Astro.params.mesto);
if (rows.length < CITY_MIN) return Astro.rewrite('/404/');
const city = rows[0].city;
const others = citiesOf(all).filter((c) => c.n >= CITY_MIN && c.slug !== Astro.params.mesto && c.region === rows[0].region).slice(0, 12);
const crumbs = [{ name: 'Domů', href: '/' }, { name: 'Pobočky', href: '/pobocky/' }, { name: `${b.short} pobočky`, href: `/pobocky/${b.slug}/` }, { name: city }];
const faq = [
  { q: `Kolik poboček má ${b.short} v ${city === 'Praha' ? 'Praze' : `obci ${city}`}?`, a: `Podle vyhledávače provozovatele ${rows.length}. Seznam s adresami a otevírací dobou je výše.` },
  { q: 'Musím na pobočku, abych mohl sledovat zápas?', a: `Ne, přenosy a sázky fungují online. ${b.partner ? `Účet u ${b.short} si založíš přes odkaz na této stránce.` : `S bonusem ${BONUS.amount} přes nás funguje Tipsport.`}` },
];
const ld = rows.map((r) => ({ '@context': 'https://schema.org', '@type': 'LocalBusiness', name: `${b.short} ${r.name}`, address: { '@type': 'PostalAddress', streetAddress: r.street, addressLocality: r.part || r.city, postalCode: r.zip, addressCountry: 'CZ' }, geo: { '@type': 'GeoCoordinates', latitude: r.lat, longitude: r.lon }, parentOrganization: { '@type': 'Organization', name: b.full } }));
---
<Base title={`${b.short} ${city} – pobočky, adresy a otevírací doba (${rows.length}) | SportStreamy`} description={`${rows.length} poboček ${b.short} – ${city}: adresy, otevírací doba a navigace. ${rows.slice(0, 2).map((r) => r.street).join(', ')}…`} ld={[breadcrumbLd(crumbs), faqLd(faq), ...ld.slice(0, 30)]} section="bonusy" ttl={3600}>
  <div class="wrap">
    <Crumbs items={crumbs} />
    <section class="pagehead">
      <h1>{b.short} {city} – pobočky</h1>
      <p class="lead">{rows.length} poboček {b.short} – {city}. Otevírací dobu přebíráme z vyhledávače provozovatele; před návštěvou ji ověř.</p>
      <div class="cta-row"><a class="btn" href={`${ctaFor(b)}?p=pobocky-mesto-${b.slug}`} rel="sponsored nofollow noopener" target="_blank">{b.partner ? `Sázej online u ${b.short}` : `Online s bonusem: Tipsport ${BONUS.amount}`}</a><span class="tag-ad">Reklama · 18+</span></div>
    </section>
    <section class="sec">
      <div class="rows">
        {rows.map((r) => (
          <div class="row" style="grid-template-columns:minmax(0,1fr) auto">
            <div style="min-width:0">
              <div class="meta"><span class="sp">{r.part || r.city}</span>{r.note ? <span class="lg">{r.note}</span> : null}{r.live ? <span class="novid">live sázky</span> : null}</div>
              <b class="tm" style="white-space:normal">{r.street}, {r.zip} {r.part || r.city}</b>
              <div class="muted" style="font-size:.84rem;margin-top:2px">{hoursText(r.hours) || 'Otevírací doba neuvedena'}</div>
            </div>
            <div class="act"><a class="btn sm ghost nav" href={mapLink(r)} rel="nofollow noopener" target="_blank">Navigovat</a></div>
          </div>
        ))}
      </div>
    </section>
    {others.length ? <section class="sec"><div class="sec-head"><h2>Další města v kraji</h2></div><div class="chips" style="flex-wrap:wrap">{others.map((c) => <a class="chip" href={`/pobocky/${b.slug}/${c.slug}/`}>{c.city}<em>{c.n}</em></a>)}</div></section> : null}
    <section class="sec"><div class="sec-head"><h2>Časté otázky</h2></div><Faq items={faq} /></section>
  </div>
</Base>
