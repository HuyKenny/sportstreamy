---
import Base from '../../layouts/Base.astro';
import Rows from '../../components/Rows.astro';
import Aside from '../../components/Aside.astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import { getEnv, view, featured, sportCounts, leagues } from '../../lib/page';
import { dayKey, addDays, longDay, plural } from '../../lib/text';
import { SPORT_BY_SLUG } from '../../lib/sports';
import { breadcrumbLd, itemListLd } from '../../lib/seo';

export const prerender = false;
const v = await view(getEnv());
const now = Date.now();
const arg = Astro.params.day ?? '';
// /program/ (= dnes), /program/zitra/, /program/2026-10-21/; /program/dnes/ is an alias of /program/.
if (arg === 'dnes') return Astro.redirect('/program/', 301);
const keys = Array.from({ length: 8 }, (_, i) => dayKey(addDays(now, i)));
const key = arg === '' ? keys[0] : arg === 'zitra' ? keys[1] : arg;
if (!keys.includes(key)) {
  // Past or too distant dates: the URL is not coming back, send people to today.
  return Astro.redirect('/program/', /^\d{4}-\d{2}-\d{2}$/.test(arg) ? 301 : 302);
}
const idx = keys.indexOf(key);
const sport = SPORT_BY_SLUG.get(Astro.url.searchParams.get('sport') ?? '');
const onlyLive = Astro.url.searchParams.get('filtr') === 'zive' && idx === 0;
const dayItems = v.upcoming.filter((m) => dayKey(m.st) === key);
const pool = onlyLive ? v.live : idx === 0 ? [...v.live, ...dayItems] : dayItems;
const filtered = sport ? pool.filter((m) => m.sp === sport.id) : pool;
const LIMIT = 150;
// A full day can hold 400+ matches (mostly table tennis): keep the top ones, point to the sport chips for the rest.
const shown = filtered.length > LIMIT ? featured(filtered).slice(0, LIMIT).sort((a, b) => a.st - b.st) : filtered;
const liveIds = new Set(v.live.map((m) => m.id));
const liveShown = shown.filter((m) => liveIds.has(m.id));
const nextShown = shown.filter((m) => !liveIds.has(m.id));
const slugOf = (i: number) => (i === 0 ? '/program/' : i === 1 ? '/program/zitra/' : `/program/${keys[i]}/`);
const short = new Intl.DateTimeFormat('cs-CZ', { timeZone: 'Europe/Prague', weekday: 'short', day: 'numeric', month: 'numeric' });
const label = (i: number) => (i === 0 ? 'Dnes' : i === 1 ? 'Zítra' : short.format(addDays(now, i)));
const counts = sportCounts({ ...v, upcoming: dayItems, live: idx === 0 ? v.live : [] });
const h = idx === 0 ? 'Program přenosů dnes' : idx === 1 ? 'Program přenosů zítra' : `Program přenosů ${longDay(addDays(now, idx))}`;
const q = (params: Record<string, string>) => {
  const u = new URLSearchParams(params);
  return `${slugOf(idx)}${u.toString() ? `?${u}` : ''}`;
};
const base = { ...(sport ? { sport: sport.slug } : {}) };
const crumbs = [{ name: 'Domů', href: '/' }, { name: 'Program', href: '/program/' }, ...(idx ? [{ name: label(idx) }] : [])];
---
<Base title={`${h}${sport ? ` – ${sport.name}` : ''} | SportStreamy`} description={`${dayItems.length} ${plural(dayItems.length, 'zápas', 'zápasy', 'zápasů')} s přenosem ${idx === 0 ? 'dnes' : idx === 1 ? 'zítra' : longDay(addDays(now, idx))}: fotbal, hokej, tenis, basketbal. Čas, soutěž, kurzy a odkaz na přenos.`} path={slugOf(idx)} noindex={!!sport || onlyLive || idx > 1} ld={[breadcrumbLd(crumbs), itemListLd(shown, h)]} section="program" ttl={idx === 0 ? 60 : 300}>
  <div class="wrap">
    <Crumbs items={crumbs} />
    <section class="pagehead">
      <div class="kicker"><span>{longDay(addDays(now, idx))}</span>{idx === 0 && v.live.length ? <span class="tag-live"><span class="dot"></span>{v.live.length} živě</span> : null}</div>
      <h1>{h}</h1>
      <p class="lead">{dayItems.length} {plural(dayItems.length, 'zápas', 'zápasy', 'zápasů')} s přenosem nebo živými statistikami. Vyber den a sport, klikni na „Sledovat“ a jsi u zápasu.</p>
    </section>
    <div class="chips" aria-label="Den">
      {keys.map((_, i) => <a class="chip" href={slugOf(i)} aria-current={i === idx ? 'page' : undefined}>{label(i)}</a>)}
    </div>
    <div class="chips" aria-label="Filtr">
      <a class="chip" href={q(base)} aria-current={!sport && !onlyLive ? 'page' : undefined}>Všechny sporty<em>{pool.length}</em></a>
      {idx === 0 ? <a class="chip" href={q({ ...base, filtr: 'zive' })} aria-current={onlyLive ? 'page' : undefined}><span class="dot"></span>Pouze živé<em>{v.live.length}</em></a> : null}
      {counts.map((s) => <a class="chip" href={q({ sport: s.slug, ...(onlyLive ? { filtr: 'zive' } : {}) })} aria-current={sport?.slug === s.slug ? 'page' : undefined}><Icon name={s.slug} />{s.name}<em>{s.total}</em></a>)}
    </div>
    <div class="cols">
      <div>
        {liveShown.length ? <section class="sec"><div class="sec-head"><h2>Živě</h2><span class="n">{liveShown.length}</span></div><Rows items={liveShown} now={now} placement="program-live" live /></section> : null}
        <section class="sec">
          {liveShown.length ? <div class="sec-head"><h2>Začne</h2><span class="n">{nextShown.length}</span></div> : null}
          <Rows items={nextShown} now={now} placement="program" empty={onlyLive ? 'Žádný zápas teď neběží.' : 'Na tenhle den zatím nemáme žádné přenosy.'} />
          {filtered.length > shown.length ? <p class="empty">Zobrazeno {shown.length} z {filtered.length} zápasů. Zbytek najdeš po výběru sportu výše.</p> : null}
        </section>
      </div>
      <Aside sports={sportCounts(v)} leagues={leagues(v)} placement="program-aside" />
    </div>
  </div>
</Base>
