---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import Crumbs from '../../components/Crumbs.astro';
import { BOOKS } from '../../lib/books';
import { BONUS } from '../../lib/bonus';
import BannerSlot from '../../components/BannerSlot.astro';
import { BANNERS } from '../../lib/banners';
import { breadcrumbLd, faqLd } from '../../lib/seo';
export const prerender = false;
const faq = [
  { q: 'Kterou kancelář vybrat pro sledování přenosů?', a: 'Nejvíc přenosů má Tipsport – z jeho nabídky je i program na tomto webu. Chance má stejné zápasy a jiné kurzy, takže se hodí na porovnání.' },
  { q: 'Musím vsadit, abych viděl přenos?', a: 'Ne. Ke sledování stačí ověřený účet a přihlášení. Sázení je dobrovolné a pouze pro osoby od 18 let.' },
  { q: `Jak získám bonus ${BONUS.amount}?`, a: 'Bonus je pro nové hráče Tipsportu: zaregistruj se přes odkaz na této stránce, ověř účet a podmínky splň podle pravidel provozovatele. Podmínky se mohou měnit, platí vždy ty na stránce Tipsportu.' },
  { q: 'Dostáváte od kanceláří provizi?', a: 'Ano. Když se zaregistruješ přes naše odkazy, můžeme dostat provizi. Tebe to nic nestojí a podmínky se tím nemění. Odkazy jsou označené jako reklama.' },
];
const crumbs = [{ name: 'Domů', href: '/' }, { name: 'Sázkové kanceláře a bonusy' }];
---
<Base title={`Sázkové kanceláře a bonusy – ${BONUS.amount} u Tipsportu | SportStreamy`} description={`Srovnání licencovaných kanceláří Tipsport, Chance a Allwyn: kde sledovat přenosy zdarma a jak získat bonus ${BONUS.amount} pro nové hráče.`} ld={[breadcrumbLd(crumbs), faqLd(faq)]} section="bonusy" ttl={600}>
  <div class="wrap">
    <Crumbs items={crumbs} />
    <section class="pagehead">
      <div class="kicker"><span class="tag-ad">Reklama · 18+</span></div>
      <h1>Sázkové kanceláře a bonusy</h1>
      <p class="lead">Přenosy vysílají licencované kanceláře svým registrovaným hráčům. Tady je stručné srovnání, kde co sledovat a jaký bonus dostaneš při registraci.</p>
    </section>
    <div class="cmp">
      {BOOKS.map((b) => (
        <div class="panel">
          <h3>{b.name}</h3>
          {b.bonus ? <div class="amt">{b.bonus}</div> : null}
          <p class="muted" style="margin:0">{b.blurb}</p>
          <ul>{b.pros.map((p) => <li>{p}</li>)}</ul>
          <a class="btn" href={`/go/${b.go}/?p=books-${b.slug}`} rel="sponsored nofollow noopener" target="_blank">{b.bonus ? `Chci ${b.bonus}` : `Přejít na ${b.name.split(' ')[0]}`}</a>
          <a href={`/sazkove-kancelare/${b.slug}/`} style="font-size:.86rem;font-weight:600;color:var(--ink-2)">Více o {b.name.split(' ')[0]} ›</a>
        </div>
      ))}
    </div>
    <div class="banners">
      <BannerSlot banner={BANNERS.tipsport1000} placement="books-banner" />
      <BannerSlot banner={BANNERS.chance200} placement="books-banner" />
    </div>
    <section class="sec prose">
      <h2>Jak sledovat přenos krok za krokem</h2>
      <ol>
        <li>Najdi zápas v <a href="/zive/">živých přenosech</a>, v <a href="/program/">programu</a> nebo přes hledání.</li>
        <li>Klikni na „Sledovat“ – otevře se stránka zápasu u Tipsportu.</li>
        <li>Přihlas se, nebo se bezplatně zaregistruj a ověř totožnost (vyžaduje zákon). Noví hráči dostanou {BONUS.amount}.</li>
        <li>Spusť přenos. Vsázet nemusíš.</li>
      </ol>
      <h2>Na co si dát pozor</h2>
      <p>Sázky jsou určené pouze osobám starším 18 let a mohou způsobit závislost. Nesázej víc, než si můžeš dovolit prohrát. Pomoc najdeš na <a href="https://www.hrajrozumne.cz" rel="noopener nofollow">hrajrozumne.cz</a> a na stránce <a href="/zodpovedne-hrani/">zodpovědné hraní</a>.</p>
    </section>
    <section class="sec"><div class="sec-head"><h2>Časté otázky</h2></div><Faq items={faq} /></section>
  </div>
</Base>
