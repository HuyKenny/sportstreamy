---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import Crumbs from '../../components/Crumbs.astro';
import BannerSlot from '../../components/BannerSlot.astro';
import { BOOKS, ctaFor } from '../../lib/books';
import { BONUS } from '../../lib/bonus';
import { BANNERS } from '../../lib/banners';
import { breadcrumbLd, faqLd } from '../../lib/seo';
export const prerender = false;
const faq = [
  { q: 'Kterou sázkovou kancelář vybrat pro sledování přenosů?', a: 'Nejvíc živých přenosů má Tipsport, sledování je po registraci zdarma. Chance má podobnou nabídku zápasů a jiné kurzy, takže se hodí na porovnání.' },
  { q: 'Musím vsadit, abych viděl přenos?', a: 'Ne. Ke sledování stačí ověřený účet a přihlášení. Sázení je dobrovolné a pouze pro osoby od 18 let.' },
  { q: 'Jaké bonusy dostanu za registraci?', a: `Přes naše odkazy: Tipsport ${BONUS.amount}, Allwyn 500 Kč, MerkurXtip 500 Kč a Chance 200 Kč pro nové hráče po registraci a ověření účtu. Podmínky stanoví provozovatel.` },
  { q: 'Proč u některých kanceláří není bonus přes vás?', a: 'S Fortunou, Betanem a Synot Tipem nemáme partnerskou smlouvu. Jejich stránky jsou informativní a odkazy na ně nejsou affiliate.' },
  { q: 'Jsou kanceláře legální?', a: 'Všechny uvedené působí v Česku na základě povolení Ministerstva financí ČR. Aktuální seznam povolených provozovatelů zveřejňuje MF ČR.' },
];
const crumbs = [{ name: 'Domů', href: '/' }, { name: 'Sázkové kanceláře' }];
const yes = (v: boolean) => (v ? 'ano' : '—');
---
<Base title={`Sázkové kanceláře – srovnání, přenosy a bonusy (${BONUS.amount} Tipsport) | SportStreamy`} description={`Srovnání sázkových kanceláří v Česku: Tipsport, Chance, Allwyn, MerkurXtip, Fortuna, Betano, Synot Tip. Přenosy, aplikace, pobočky a bonusy: Tipsport ${BONUS.amount}, Allwyn a MerkurXtip 500 Kč, Chance 200 Kč.`} ld={[breadcrumbLd(crumbs), faqLd(faq)]} section="bonusy" ttl={3600}>
  <div class="wrap">
    <Crumbs items={crumbs} />
    <section class="pagehead">
      <div class="kicker"><span class="tag-ad">Reklama · 18+</span></div>
      <h1>Sázkové kanceláře</h1>
      <p class="lead">Srovnání licencovaných kanceláří v Česku z pohledu diváka: kde jsou živé přenosy, jaká je aplikace, jestli mají pobočky a jaký bonus dostaneš.</p>
    </section>
    <section class="sec">
      <div class="tablewrap">
        <table class="cmp-table">
          <thead><tr><th>Kancelář</th><th>Živé přenosy</th><th>Pobočky</th><th>Bonus přes nás</th><th></th></tr></thead>
          <tbody>
            {BOOKS.map((b) => (
              <tr>
                <td><a href={`/sazkove-kancelare/${b.slug}/`}><b>{b.name}</b></a><br /><span class="muted" style="font-size:.8rem">{b.full}</span></td>
                <td class={b.streams ? 'y' : 'n'} data-l="Přenosy">{yes(b.streams)}</td>
                <td class={b.branches ? 'y' : 'n'} data-l="Pobočky">{b.branches ? <a href={`/pobocky/${b.slug}/`}>ano</a> : '—'}</td>
                <td class={b.bonus ? 'y' : 'n'} data-l="Bonus">{b.bonus ?? '—'}</td>
                <td class="cta">{b.partner ? <a class="btn sm" href={`${ctaFor(b)}?p=books-table-${b.slug}`} rel="sponsored nofollow noopener" target="_blank">{b.bonus ? `Chci ${b.bonus}` : 'Přejít'}</a> : <a class="btn sm ghost" href={`/sazkove-kancelare/${b.slug}/`}>Více</a>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
    <div class="banners">
      <BannerSlot banner={BANNERS.tipsport1000} placement="books-banner" />
      <BannerSlot banner={BANNERS.chance200} placement="books-banner" />
    </div>
    <section class="sec">
      <div class="sec-head"><h2>Nejhledanější</h2></div>
      <div class="chips">
        <a class="chip" href="/sazkove-kancelare/tipsport/tv/">Tipsport TV</a>
        <a class="chip" href="/sazkove-kancelare/tipsport/aplikace/">Tipsport aplikace</a>
        <a class="chip" href="/sazkove-kancelare/tipsport/kontrola-tiketu/">Tipsport kontrola tiketu</a>
        <a class="chip" href="/sazkove-kancelare/betano/bonus/">Betano promo kód</a>
        <a class="chip" href="/sazkove-kancelare/fortuna/aplikace/">Fortuna aplikace</a>
        <a class="chip" href="/sazkove-kancelare/fortuna/kontrola-tiketu/">Fortuna kontrola tiketu</a>
        <a class="chip" href="/pobocky/">Pobočky sázkových kanceláří</a>
        <a class="chip" href="/clanky/dan-z-vyhry-sazky/">Daň z výhry</a>
      </div>
    </section>
    <section class="sec prose">
      <h2>Jak sledovat přenos krok za krokem</h2>
      <ol>
        <li>Najdi zápas v <a href="/zive/">živých přenosech</a>, v <a href="/program/">programu</a> nebo přes hledání.</li>
        <li>Klikni na „Sledovat“ – otevře se stránka zápasu u Tipsportu.</li>
        <li>Přihlas se, nebo se bezplatně zaregistruj a ověř totožnost (vyžaduje zákon). Noví hráči dostanou {BONUS.amount}.</li>
        <li>Spusť přenos. Vsázet nemusíš.</li>
      </ol>
      <h2>Na co si dát pozor</h2>
      <p>Sázky jsou určené pouze osobám starším 18 let a mohou způsobit závislost. Nesázej víc, než si můžeš dovolit prohrát. Pomoc najdeš na <a href="https://www.hrajrozumne.cz" rel="noopener nofollow">hrajrozumne.cz</a> a na stránce <a href="/zodpovedne-hrani/">zodpovědné hraní</a>.</p>
    </section>
    <section class="sec"><div class="sec-head"><h2>Časté otázky</h2></div><Faq items={faq} /></section>
  </div>
</Base>
